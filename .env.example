# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored, so your real credentials stay out of version control.

# --- Supabase (used as the WebRTC signaling channel) ---
# Create a FREE project at https://supabase.com , then:
#   Project Settings -> API -> copy "Project URL" and the "anon public" key.
VITE_SUPABASE_URL=https://whfuifukebfnhxvlmini.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Nl9AdiuB7FoN5SuZhxYDiA_G6ymsOxi

# --- Optional: TURN server (needed when STUN alone fails) ---
# Many home networks work with STUN only. Corporate / strict / symmetric NAT
# networks (roughly 10-20% of users) require a TURN relay to connect at all.
# Get free/paid credentials from e.g. https://www.metered.ca/tools/openrelay/
# or https://dashboard.twilio.com (Network Traversal Service).
#
# If you leave these blank, the app falls back to STUN-only.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
